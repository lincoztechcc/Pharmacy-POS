# Supabase Database Configuration (Enterprise Pooled + Direct Connections)
# 1. Transaction Pooler URL (Supavisor Port 6543) — Used by Prisma Client at runtime for high concurrency
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# 2. Session / Direct Connection URL (Port 5432) — Used by Prisma CLI for migrations (`prisma db push` / `prisma migrate`)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional Pool Tuning (per serverless/server instance)
DB_POOL_MAX="10"

# JWT Authentication
JWT_SECRET="generate_a_long_random_string_here"

# Next.js Config
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Credentials (Initial setup)
MASTER_SUPER_ADMIN_EMAIL="lincoztech@gmail.com"
MASTER_SUPER_ADMIN_PASS="Lincoz@Tech-2"

DATABASE_URL="postgresql://postgres.oqchnotpxrvbeipmipdv:lincoztechpharmacy@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Session Pooler Connection URL (Port 5432) — Used by Prisma CLI for migrations (`prisma db push` / `prisma migrate`)
DIRECT_URL="postgresql://postgres.oqchnotpxrvbeipmipdv:lincoztechpharmacy@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Optional Pool Tuning (per serverless/server instance)
